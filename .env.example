# Copy to .env (gitignored). Testnet throwaway keys only. Never use a key that holds real funds.
SENFUND_ENV=testnet
DEPLOYER_PRIVATE_KEY=0x<testnet-deployer-key>
MERCHANT_PRIVATE_KEY=0x<testnet-merchant-signing-key>
MERCHANT_RECIPIENT=0x<testnet-recipient-address>
PAYER_PRIVATE_KEY=0x<testnet-payer-key>
SENFUND_CONFIRMATIONS=2
# SENFUND_RPC_URL=https://rpc.testnet.whitechain.io
# SENFUND_LIVE_PAYOUTS must stay unset; the app refuses to start if it is enabled.
# Ethereum Sepolia ENSv2. Use a public browser-accessible URL with no credentials.
# SENFUND_ENS_RPC=https://<public-ethereum-sepolia-rpc>
# SENFUND_ENS_NAME=merchant.<your-parent>.eth
# SENFUND_ENS_RESOLVER=0x<dedicated-permissioned-resolver>

# Enable the Chainlink CRE CLI gate for simulated payouts after installing and logging into CRE.
# SENFUND_CRE_PAYOUTS=1
# SENFUND_CRE_CLI=/absolute/path/to/cre
