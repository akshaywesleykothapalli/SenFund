# Copy to .env (gitignored). Testnet throwaway keys only. Never use a key that holds real funds.
SENFUND_ENV=testnet
DEPLOYER_PRIVATE_KEY=0x<testnet-deployer-key>
MERCHANT_PRIVATE_KEY=0x<testnet-merchant-signing-key>
MERCHANT_RECIPIENT=0x<testnet-recipient-address>
PAYER_PRIVATE_KEY=0x<testnet-payer-key>
SENFUND_CONFIRMATIONS=2
# SENFUND_RPC_URL=https://rpc.testnet.whitechain.io
# SENFUND_LIVE_PAYOUTS must stay unset; the app refuses to start if it is enabled.
# ENSv2 reads. Default is Sepolia. For Continuity use mainnet with its enrolled name and resolver.
# Whitechain payment remains on testnet in either mode. Use a public HTTPS RPC without credentials.
# SENFUND_ENS_NETWORK=sepolia
# SENFUND_ENS_RPC=https://<public-ethereum-sepolia-rpc>
# SENFUND_ENS_NAME=merchant.<your-parent>.eth
# SENFUND_ENS_RESOLVER=0x<dedicated-permissioned-resolver>

# Enable the Chainlink CRE CLI gate for simulated payouts after installing and logging into CRE.
# SENFUND_CRE_PAYOUTS=1
# SENFUND_CRE_CLI=/absolute/path/to/cre
# Local operator demo only. Requires enabled CRE, ENSv2 settings and compiled CCIP contracts.
# SENFUND_CCIP_LOCAL=1

# Optional private testnet account mode. Configure a real HTTPS OIDC issuer and
# register SENFUND_APP_ORIGIN/api/auth/callback as an exact redirect URI.
# SENFUND_ACCOUNT_MODE=1
# SENFUND_APP_ORIGIN=http://127.0.0.1:3000
# SENFUND_OIDC_ISSUER=https://<identity-provider-issuer>
# SENFUND_OIDC_CLIENT_ID=<client-id>
# SENFUND_OIDC_CLIENT_SECRET=<client-secret>
# SENFUND_API_BRIDGE_SECRET=<at-least-32-random-characters>
# SENFUND_OPERATOR_SUBJECT=<verified-identity-provider-subject>

# Local email/password workspace. Configure a random bridge secret and seed admin hash locally.
# SENFUND_LOCAL_AUTH=1
# SENFUND_LOCAL_ADMIN_PASSWORD_HASH=<salted-scrypt-hash>
# SENFUND_APP_ORIGIN=http://127.0.0.1:3000
# SENFUND_CHECKOUT_URL=https://<public-static-checkout-origin>/
